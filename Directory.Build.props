<Project>

  <!--
    Shared build settings for every project in the repository.
    Keeping them here guarantees that the library, the API demo and the test
    projects are all compiled with the same language level and warning policy.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Quality gate. Warnings fail the build so they cannot accumulate, the
      .editorconfig style rules are enforced by the compiler rather than only in
      the IDE, and the recommended analyser set is opted into explicitly.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!--
    Package identity shared by both shippable packages. Kept here so the licence, copyright
    and repository links cannot drift apart between them. Each project still declares its own
    PackageId, description and tags.
  -->
  <PropertyGroup>
    <Authors>Abed Alawiyeh</Authors>
    <Copyright>Copyright (c) 2026 Abed Alawiyeh</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/abedalawieh/OldPhonePad</PackageProjectUrl>
    <RepositoryUrl>https://github.com/abedalawieh/OldPhonePad.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Debuggability. SourceLink stamps the built assemblies with the commit they came from, so a
    customer can step into this library's source from their own debugger instead of decompiling
    it. Symbols ship as a .snupkg alongside each package rather than inside it, which is what
    nuget.org expects. ContinuousIntegrationBuild is set by the build workflow, not here, because
    it normalises paths in a way that only makes sense for a clean checkout.
  -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
