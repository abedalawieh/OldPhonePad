<Project>

  <!--
    Shared build settings for every project in the repository.
    Keeping them here guarantees that the library, the API demo and the test
    projects are all compiled with the same language level and warning policy.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Quality gate. Warnings fail the build so they cannot accumulate, the
      .editorconfig style rules are enforced by the compiler rather than only in
      the IDE, and the recommended analyser set is opted into explicitly.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

</Project>
