<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, Nullable and warning policy are inherited from Directory.Build.props. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      ASP.NET Core 10 feeds XML documentation comments into the generated OpenAPI document, so
      the summaries and <example> values written on the request and response contracts become the
      descriptions and sample payloads a customer sees in the interactive reference.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generates the OpenAPI document. Part of ASP.NET Core; no third party involved. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />

    <!--
      Direct reference on purpose, not because the API calls into it.

      Microsoft.AspNetCore.OpenApi 10.0.10 depends on Microsoft.OpenApi 2.0.0, which carries a
      known high severity advisory (GHSA-v5pm-xwqc-g5wc: circular schema references can terminate
      OpenAPI parsing). 2.7.5 is the first patched release, and naming it here overrides the
      transitive version. The lowest patched version is used rather than the newest so that the
      library stays as close as possible to the version ASP.NET Core 10 was built against.

      Remove this line once a Microsoft.AspNetCore.OpenApi patch ships that references 2.7.5 or later.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />

    <!--
      Renders the generated OpenAPI document as an interactive page customers can execute
      requests from. ASP.NET Core 10 generates the document but ships no UI of its own.
    -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OldPhonePad\OldPhonePad.csproj" />
    <ProjectReference Include="..\OldPhonePad.DependencyInjection\OldPhonePad.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
