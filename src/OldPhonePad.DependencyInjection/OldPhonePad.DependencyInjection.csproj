<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable and warning policy are inherited from Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>IronSoftware.OldPhonePad.DependencyInjection</RootNamespace>
    <AssemblyName>IronSoftware.OldPhonePad.DependencyInjection</AssemblyName>

    <!-- Public members are documented; missing XML docs surface as build warnings. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Shipped separately from the keypad library on purpose. The registration helper needs the
    dependency injection abstractions, and putting them in the core package would give every
    consumer a dependency they did not ask for - including those using the library from a
    console app or another library with no container at all.
  -->
  <PropertyGroup>
    <PackageId>IronSoftware.OldPhonePad.DependencyInjection</PackageId>
    <Version>1.0.0</Version>
    <Description>
      Dependency injection support for IronSoftware.OldPhonePad. Adds AddOldPhonePad() so the
      keypad converter can be registered with Microsoft.Extensions.DependencyInjection. The
      keypad library itself has no dependencies; this package is optional.
    </Description>
    <PackageTags>keypad;multi-tap;phone;dependency-injection;di</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OldPhonePad\OldPhonePad.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only dependency, and the reason this package exists separately. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown on the package listing page. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
