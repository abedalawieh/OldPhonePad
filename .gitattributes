# Normalise line endings so the repository is identical on Windows, macOS and Linux.
#
# Text files are stored with LF and checked out with CRLF on every platform, because
# .editorconfig sets `end_of_line = crlf` for all files. Without the explicit `eol=crlf`
# a Linux or macOS checkout gets LF, and `dotnet format --verify-no-changes` then fails
# on files that are correct on Windows - which is exactly what CI caught.
* text=auto eol=crlf

*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.props     text
*.targets   text
*.json      text
*.md        text
*.yml       text
*.editorconfig text

# Shell scripts must keep LF whatever the rule above says: a CRLF shebang
# is not executable on Linux or macOS.
*.sh        text eol=lf

# Binary assets must never be normalised.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.dll binary
*.snk binary
